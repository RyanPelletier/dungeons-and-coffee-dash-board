# Firebase project config (Project settings -> General -> Your apps -> SDK setup and configuration).
# These are safe to expose in client-side code; access control is enforced by
# firestore.rules / storage.rules, not by keeping this config secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the app at a local `firebase emulators:start`
# instance instead of your real Firebase project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Only used by `npm run build` when building for GitHub Pages (the deploy
# workflow sets this automatically) — leave unset for local dev.
# NEXT_BASE_PATH=/dungeons-and-coffee-dash-board
