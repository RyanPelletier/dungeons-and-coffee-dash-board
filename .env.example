# Firebase project config (Project settings -> General -> Your apps -> SDK setup and configuration).
# These are safe to expose in client-side code; access control is enforced by
# firestore.rules, not by keeping this config secret. Firebase Storage is
# deliberately not used (it requires the paid Blaze plan just to provision a
# bucket) — see the Cloudinary vars below for image uploads instead.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary (free tier, no card required) handles session/comment image
# uploads. Create an account, then Settings -> Upload -> Upload presets ->
# add an "Unsigned" preset, and fill in both values below.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Set to "true" to point the app at a local `firebase emulators:start`
# instance instead of your real Firebase project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Only used by `npm run build` when building for GitHub Pages (the deploy
# workflow sets this automatically) — leave unset for local dev.
# NEXT_BASE_PATH=/dungeons-and-coffee-dash-board
